# =============================================================================
#  Plymouth script — Mak OS splash
# =============================================================================
window.SetBackgroundTopColor (0.06, 0.07, 0.09);
window.SetBackgroundBottomColor (0.09, 0.11, 0.14);

logo.image = Image ("background.png");
logo.sprite = Sprite ();
logo.sprite.SetImage (logo.image);
logo.sprite.SetX (Window.GetWidth () / 2 - logo.image.GetWidth () / 2);
logo.sprite.SetY (Window.GetHeight () / 2 - logo.image.GetHeight () / 2);

# marca "M" central (círculo + glifos) — desenho próprio
brand.sprite = Sprite ();
brand.image = Image ("mak-m.png");
brand.sprite.SetImage (brand.image);
brand.sprite.SetX (Window.GetWidth () / 2 - 100);
brand.sprite.SetY (Window.GetHeight () / 2 - 80);

# barra de progresso
bar.width = 320;
bar.height = 6;
bar.sprite = Sprite ();
bar.image = Image.Circle (bar.width, bar.height, 0);
bar.image = bar.image.Scale (bar.width, bar.height);
bar.sprite.SetImage (bar.image);
bar.sprite.SetX (Window.GetWidth () / 2 - bar.width / 2);
bar.sprite.SetY (Window.GetHeight () / 2 + 120);

progress.width = 0;
progress.sprite = Sprite ();

message.sprite = Sprite ();
message.text = "Mak OS";
message.sprite.SetText (message.text);
message.sprite.SetX (Window.GetWidth () / 2 - message.sprite.GetWidth () / 2);
message.sprite.SetY (Window.GetHeight () / 2 + 140);

fun refresh_callback ()
{
    progress.width = progress.width + 4;
    if (progress.width > bar.width) {
        progress.width = 0;
    }
    progress.image = Image.Circle (progress.width, bar.height, 0);
    progress.image = progress.image.Scale (progress.width, bar.height);
    progress.image = progress.image.Colorize (0.31, 0.62, 0.87, 1.0);
    progress.sprite.SetImage (progress.image);
    progress.sprite.SetX (bar.sprite.GetX ());
    progress.sprite.SetY (bar.sprite.GetY ());
    progress.sprite.SetOpacity (0.9);
}

Plymouth.SetRefreshFunction (refresh_callback);
