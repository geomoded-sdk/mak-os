# =============================================================================
#  Plymouth script — Pineapple OS (boot estilo Apple)
#
#  Imita a tela de boot do macOS: fundo #c2bec2, abacaxi de contorno no
#  centro (mordida à direita, levemente inclinado) e uma fina barra de
#  progresso logo abaixo, sem textos.
# =============================================================================

# --- fundo #c2bec2 (cor sólida, como o boot do macOS) ---
window.SetBackgroundTopColor (0.761, 0.745, 0.761);
window.SetBackgroundBottomColor (0.761, 0.745, 0.761);

# --- abacaxi de contorno, centralizado ---
logo.image = Image ("pineapple.png");
logo.sprite = Sprite ();
logo.sprite.SetImage (logo.image);
logo.sprite.SetX (Window.GetWidth () / 2 - logo.image.GetWidth () / 2);
logo.sprite.SetY (Window.GetHeight () / 2 - logo.image.GetHeight () / 2);

# --- trilho da barra de progresso (fino, como no boot do macOS) ---
bar.width = 340;
bar.height = 6;
bar.sprite = Sprite ();
bar.image = Image.Circle (bar.width, bar.height, 0);
bar.image = bar.image.Scale (bar.width, bar.height);
bar.image = bar.image.Colorize (0.62, 0.61, 0.62, 1.0);   # cinza do contorno
bar.sprite.SetImage (bar.image);
bar.sprite.SetX (Window.GetWidth () / 2 - bar.width / 2);
bar.sprite.SetY (Window.GetHeight () / 2 + logo.image.GetHeight () / 2 + 40);

# --- preenchimento da barra (na cor do contorno #7a767a) ---
progress.width = 0;
progress.sprite = Sprite ();

# --- animação suave do preenchimento (simula o avanço do boot) ---
anim = 0;

fun update_bar ()
{
    progress.width = anim * bar.width;
    progress.image = Image.Circle (progress.width, bar.height, 0);
    progress.image = progress.image.Scale (progress.width, bar.height);
    progress.image = progress.image.Colorize (0.478, 0.463, 0.478, 1.0);  # #7a767a
    progress.sprite.SetImage (progress.image);
    progress.sprite.SetX (bar.sprite.GetX ());
    progress.sprite.SetY (bar.sprite.GetY ());
}

fun refresh_callback ()
{
    anim = anim + 0.02;
    if (anim > 1) {
        anim = 0;
    }
    update_bar ();
}

Plymouth.SetRefreshFunction (refresh_callback);