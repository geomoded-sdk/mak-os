---
# =============================================================================
#  Calamares — branding do Pineapple OS (estilo instalador macOS)
# =============================================================================
componentName: pineappleos-branding

welcomeStyleCss: |
  .welcome-title {
    font-size: 32px;
    font-weight: 700;
    color: #163b32;
  }
  .welcome-message {
    font-size: 15px;
    color: #53665f;
  }
  .welcome-window {
    background: #f4f7ef;
  }
  .welcome-button {
    background: #e5b84b;
    color: #163b32;
    border-radius: 10px;
  }

welcomeWindowTitle: Instalar Pineapple OS

welcomeHeader: Configure seu Pineapple

welcomeMessage: |
  Configure o Pineapple OS em algumas etapas: idioma, teclado, rede, disco e usuário.<br/>
  Você escolherá explicitamente o disco e o modo de particionamento antes da instalação.<br/><br/>
  <strong>Importante:</strong> faça backup dos seus dados e revise o resumo final antes de confirmar.

welcomeImage: pineapple-logo

supportUrl: https://github.com/geomoded-sdk/mak-os

knownIssuesUrl: https://github.com/geomoded-sdk/mak-os/issues

releaseNotesUrl: https://github.com/geomoded-sdk/mak-os/releases

styleName: Pineapple OS

brandingShort: Pineapple OS

productName: Pineapple OS

version: 0.1.0

shortVersion: 0.1

bootloaderEntryName: Pineapple OS

slideShowPath: show.qml

slideShowDelay: 3000
