---
# =============================================================================
#  Calamares — branding do Mak OS (estilo instalador macOS)
# =============================================================================
componentName: makos-branding

welcomeStyleCss: |
  .welcome-title {
    font-size: 34px;
    font-weight: 700;
    color: #1d1d1f;
  }
  .welcome-message {
    font-size: 15px;
    color: #6e6e73;
  }

welcomeWindowTitle: Instalar Mak OS

welcomeHeader: Bem-vindo ao instalador do Mak OS

welcomeMessage: |
  Para instalar o Mak OS você precisará de um disco com espaço livre.<br/>
  O instalador apagará o conteúdo do disco selecionado antes de continuar.<br/><br/>
  <strong>Importante:</strong> faça backup dos seus dados antes de instalar.

welcomeImage: mak-logo

supportUrl: https://example.org/makos/support

knownIssuesUrl: https://example.org/makos/issues

releaseNotesUrl: https://example.org/makos/release-notes

styleName: Mak OS

brandingShort: Mak OS

productName: Mak OS

version: 0.1.0

shortVersion: 0.1

bootloaderEntryName: Mak OS

slideShowPath: show.qml

slideShowDelay: 3000
