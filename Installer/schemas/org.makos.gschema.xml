<?xml version="1.0" encoding="UTF-8"?>
<schemalist>

  <schema id="org.makos.desktop" path="/org/makos/desktop/">
    <key name="theme-name" type="s">
      <default>'Mak-Dark'</default>
      <summary>Tema GTK ativo</summary>
      <description>Nome do tema GTK usado pelo Mak OS.</description>
    </key>
    <key name="color-scheme" type="s">
      <default>'prefer-dark'</default>
      <choices>
        <choice value='prefer-light'/>
        <choice value='prefer-dark'/>
        <choice value='default'/>
      </choices>
    </key>
    <key name="background" type="s">
      <default>'/usr/share/backgrounds/makos/wallpaper.svg'</default>
      <summary>Imagem de fundo da área de trabalho</summary>
    </key>
    <key name="primary-color" type="s">
      <default>'#4f9dde'</default>
      <summary>Cor primária da identidade</summary>
    </key>
    <key name="accent-color" type="s">
      <default>'#e2776f'</default>
      <summary>Cor de destaque da identidade</summary>
    </key>
  </schema>

  <schema id="org.makos.dock" path="/org/makos/dock/">
    <key name="icon-size" type="i">
      <default>48</default>
      <range min="24" max="96"/>
    </key>
    <key name="magnification" type="b">
      <default>true</default>
    </key>
    <key name="auto-hide" type="b">
      <default>false</default>
    </key>
    <key name="pinned" type="as">
      <default>['mak-finder', 'mak-terminal', 'mak-browser', 'mak-music', 'mak-photos', 'mak-notes', 'mak-store', 'mak-settings', 'mak-calc']</default>
    </key>
  </schema>

  <schema id="org.makos.session" path="/org/makos/session/">
    <key name="workspaces" type="i">
      <default>4</default>
      <range min="1" max="16"/>
    </key>
    <key name="compositor" type="s">
      <default>'labwc'</default>
    </key>
    <key name="autostart" type="as">
      <default>['mak-finder', 'mak-settings']</default>
      <description>Apps iniciados junto com a sessão</description>
    </key>
  </schema>

  <schema id="org.makos.ai" path="/org/makos/ai/">
    <key name="enabled" type="b">
      <default>true</default>
    </key>
    <key name="model" type="s">
      <default>'llama3.1'</default>
    </key>
    <key name="ollama-url" type="s">
      <default>'http://127.0.0.1:11434'</default>
    </key>
    <key name="wake-word" type="s">
      <default>'mak'</default>
    </key>
  </schema>

  <schema id="org.makos.appearance" path="/org/makos/appearance/">
    <key name="font" type="s">
      <default>'Sora 10'</default>
    </key>
    <key name="icon-theme" type="s">
      <default>'mak-icons'</default>
    </key>
    <key name="cursor-theme" type="s">
      <default>'Adwaita'</default>
    </key>
    <key name="night-light" type="b">
      <default>false</default>
    </key>
  </schema>

  <schema id="org.makos.notifications" path="/org/makos/notifications/">
    <key name="show-banners" type="b">
      <default>true</default>
    </key>
    <key name="do-not-disturb" type="b">
      <default>false</default>
    </key>
  </schema>

</schemalist>
