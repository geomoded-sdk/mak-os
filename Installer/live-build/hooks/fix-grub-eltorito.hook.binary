#!/bin/sh

## fix-grub-eltorito.hook.binary — regenera o grub_eltorito do ISO
##
## O live-build 3.0~a57 gera o grub_eltorito com:
##   grub-mkimage -d /usr/lib/grub/i386-pc -o $core -O i386-pc biosdisk iso9660
## O grub-mkimage 2.12 (Debian trixie) removeu o prefix padrão e exige -p;
## sem ele o core.img não é gerado e o ISO fica sem boot BIOS.

set -e

INPUT_DIR=/usr/lib/grub/i386-pc
CORE_IMG=/root/grub-core.tmp

chroot chroot grub-mkimage -d "${INPUT_DIR}" -o "${CORE_IMG}" -O i386-pc -p /boot/grub biosdisk iso9660
cat "chroot/${INPUT_DIR}/cdboot.img" "chroot/${CORE_IMG}" > binary/boot/grub/grub_eltorito
rm -f "chroot/${CORE_IMG}"